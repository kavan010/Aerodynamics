{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build sim",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-O2",
                "-march=native",
                "${workspaceFolder}/aero.cpp",
                "-o",
                "${workspaceFolder}/sim",
                "-lGLEW",
                "-lglfw",
                "-lGL",
                "-lGLU",
                "-lX11"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile aero.cpp into ./sim"
        }
    ]
}
