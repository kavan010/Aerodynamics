{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build sim",
            "command": "/opt/cuda/bin/nvcc",
            "args": [
                "-O2", "-arch=sm_86", "--extended-lambda", "-std=c++17",
                "-Xcompiler", "-fopenmp,-march=native",
                "${workspaceFolder}/aero.cu",
                "-o", "${workspaceFolder}/sim",
                "-lGLEW", "-lglfw", "-lGL", "-lGLU", "-lX11", "-lgomp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile aero.cpp into ./sim"
        }
    ]
}
